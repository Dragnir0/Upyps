{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.upyps.com"
        }
      ],
      "destination": "https://upyps.com/$1",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/fr/resources",
      "permanent": true
    },
    {
      "source": "/legal",
      "destination": "/fr/legal",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^en.*"
        }
      ],
      "destination": "/en",
      "permanent": false
    },
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept-language",
          "value": "^fr.*"
        }
      ],
      "destination": "/fr",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://banner-api.hfm.com; font-src 'self'; frame-src https://prices.hfmarkets.com https://banner-api.hfm.com; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/(styles\\.css|main\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon\\.svg|apple-touch-icon\\.png|icon-512\\.png|og\\.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/schedule.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/fr/resources",
      "destination": "/fr-resources.html"
    },
    {
      "source": "/en/resources",
      "destination": "/en-resources.html"
    },
    {
      "source": "/fr/legal",
      "destination": "/fr-legal.html"
    },
    {
      "source": "/en/legal",
      "destination": "/en-legal.html"
    },
    {
      "source": "/fr/risk",
      "destination": "/fr-risk.html"
    },
    {
      "source": "/en/risk",
      "destination": "/en-risk.html"
    },
    {
      "source": "/fr/a-propos",
      "destination": "/fr-a-propos.html"
    },
    {
      "source": "/en/about",
      "destination": "/en-about.html"
    },
    {
      "source": "/fr/guide-comptes-hfm",
      "destination": "/fr-guide-comptes-hfm.html"
    },
    {
      "source": "/en/hfm-account-guide",
      "destination": "/en-hfm-account-guide.html"
    },
    {
      "source": "/fr/hfm-demo-guide",
      "destination": "/fr-hfm-demo-guide.html"
    },
    {
      "source": "/en/hfm-demo-guide",
      "destination": "/en-hfm-demo-guide.html"
    },
    {
      "source": "/fr/hfm-regulation",
      "destination": "/fr-hfm-regulation.html"
    },
    {
      "source": "/en/hfm-regulation",
      "destination": "/en-hfm-regulation.html"
    }
  ]
}
